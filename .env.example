# Copy to .env (cp .env.example .env). The app reads .env at start-up; the Agent SDK reads the same variables from the process environment.
# Everything below is optional. With nothing set, Lookout runs on saved agent runs: no key, no cost, no network.

# The one variable to set for live runs. Lookout's agent runs on Anthropic models only: an OpenAI or Google key is not used.
# Cost with a key: about 0.10 to 0.20 USD per item run; the first start works the five top items live once (about 1 USD); `make eval` about 3 USD.
ANTHROPIC_API_KEY=

# Alternative to a key: run live through a logged-in Claude Code CLI (set to 1). Ignored when the key above is set.
LOOKOUT_LIVE=

# Which runs go to the model. auto (default): live with a key, else saved runs. hybrid: whatever has a saved run replays it (fast, the
# same every time) and only what has none (a new message, another part, a new question) runs live, and only with a key. live / recorded force it.
LOOKOUT_MODE=

# Models. Lookout, the Buyer's clerk and the Data steward use LOOKOUT_MODEL; the Supply planner, the Tariff and Sourcing analysts, the Inbox analyst
# and the Reviewer use LOOKOUT_FAST_MODEL. The verifier is code, not a model.
LOOKOUT_MODEL=claude-sonnet-5-5
LOOKOUT_FAST_MODEL=claude-haiku-5-5

# Hard caps, enforced in code: turns per specialist, and USD per run (subagents included).
LOOKOUT_MAX_TURNS=12
LOOKOUT_MAX_BUDGET_USD_PER_RUN=1

# Evals only: stop `make eval` once this many USD have been spent in the process, and the model that judges the agent's prose (a different one from the agent's).
LOOKOUT_EVAL_BUDGET_USD=5
LOOKOUT_JUDGE_MODEL=claude-opus-5-5

# Leave these unset unless you know why. LOOKOUT_DB: where the SQLite file is (a relative path is relative to this folder; default backend/lookout.db).
# LOOKOUT_AS_OF=2026-09-17 shows the data as it stood that day (build with the same value: make build-data AS_OF=2026-09-17).
# LOOKOUT_DB=backend/lookout.db
# LOOKOUT_AS_OF=
